@page
@model OnlineShop.pages_customers.EditModel

@{
    ViewData["Title"] = "Customer Edit";
    Layout = "_layout";
}

<h4>Customer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Customer.Id" />
            <div class="form-group">
                <label asp-for="Customer.name" class="control-label"></label>
                <input asp-for="Customer.name" class="form-control" />
                <span asp-validation-for="Customer.name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.email" class="control-label"></label>
                <input asp-for="Customer.email" class="form-control" />
                <span asp-validation-for="Customer.email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

